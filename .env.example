# Fill only the providers you choose. Codex CLI does not need a new API key.
# Web Settings can save keys to ignored .env.local beside your config.

DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

KIMI_API_KEY=
# MOONSHOT_API_KEY is also accepted.
# KIMI_BASE_URL=https://api.moonshot.ai/v1

MIMO_API_KEY=
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# Token Plan / regional plans: use the exact URL from your console.

QWEN_API_KEY=
# DASHSCOPE_API_KEY is also accepted.
# QWEN_BASE_URL=your region/workspace-specific compatible endpoint

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

CUSTOM_API_KEY=
# CUSTOM_BASE_URL=http://127.0.0.1:11434/v1

# Optional image API; separate from your text provider. No key needed for CLI/local generation.
IMAGE_API_KEY=

# Optional Telegram receiver. Set allowed_chat_ids in config before enabling.
TELEGRAM_BOT_TOKEN=
